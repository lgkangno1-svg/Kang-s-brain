# Korea Concierge Environment Variables (Example Template)
# Never commit real secret keys or expose them to the browser bundle.

# Deployment & Domain Configuration
NEXT_PUBLIC_SITE_URL=https://korea.avocadoss.co.kr

# Stripe Global Payment Configuration
# Server-only secrets
STRIPE_SECRET_KEY=sk_test_example_key
STRIPE_WEBHOOK_SECRET=whsec_example_webhook_secret

# Approved Stripe Price IDs (One per product key)
STRIPE_PRICE_ID_HANBOK_MATCH=price_example_hanbok_match
STRIPE_PRICE_ID_NAMING_STUDIO=price_example_naming_studio
STRIPE_PRICE_ID_TRIP_PASS_BASIC=price_example_trip_pass_basic
STRIPE_PRICE_ID_TRIP_PASS_ADVANCED=price_example_trip_pass_advanced
STRIPE_PRICE_ID_TRIP_PASS_ULTRA=price_example_trip_pass_ultra
