# Korea Concierge Environment Variables (Example Template)
# Never commit real secret keys or expose them to the browser bundle.

# Deployment & Domain Configuration
NEXT_PUBLIC_SITE_URL=https://korea.avocadoss.co.kr

# Payments remain fail-closed until every launch gate is evidenced.
# All three must be true before checkout code can open.
# KOREA_PAYMENT_OWNERSHIP_READY must only become true after authenticated user ownership,
# order persistence and RLS are deployed and tested in the dedicated Korea database.
# KOREA_PAYMENT_FULFILLMENT_READY must only become true after paid-result generation,
# private delivery, retry/recovery and refund handling pass E2E tests.
STRIPE_CHECKOUT_ENABLED=false
KOREA_PAYMENT_OWNERSHIP_READY=false
KOREA_PAYMENT_FULFILLMENT_READY=false

# Dedicated Korea Concierge Supabase project. Do not point these at another service's DB.
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example
# Server-only secret/service credential. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_example

# Stripe test-mode configuration only while provider/legal-entity eligibility is unresolved.
# Server-only secrets. Replace examples only in the deployment secret store, never in git.
STRIPE_SECRET_KEY=sk_test_example_key
STRIPE_WEBHOOK_SECRET=whsec_example_webhook_secret

# First paid launch SKU: My Korea Look / my_korea_look_v1.
# The provider-side price/currency/tax configuration must match the approved launch contract.
STRIPE_PRICE_ID_MY_KOREA_LOOK_V1=price_example_my_korea_look_v1

# Legacy/future product mappings are retained for development compatibility only and are
# not eligible for the first-product launch checkout route.
STRIPE_PRICE_ID_HANBOK_MATCH=price_example_hanbok_match
STRIPE_PRICE_ID_NAMING_STUDIO=price_example_naming_studio
STRIPE_PRICE_ID_TRIP_PASS_BASIC=price_example_trip_pass_basic
STRIPE_PRICE_ID_TRIP_PASS_ADVANCED=price_example_trip_pass_advanced
STRIPE_PRICE_ID_TRIP_PASS_ULTRA=price_example_trip_pass_ultra
